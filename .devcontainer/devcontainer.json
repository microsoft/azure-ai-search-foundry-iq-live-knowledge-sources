{
  "name": "Foundry IQ Live Knowledge Sources",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "version": "22",
      "pnpmVersion": "none"
    },
    "ghcr.io/devcontainers/features/azure-cli:1.3.0": {
      "version": "2.86.0",
      "installBicep": true,
      "bicepVersion": "v0.44.1"
    },
    "ghcr.io/azure/azure-dev/azd:0.2.0": {
      "version": "1.28.0"
    }
  },
  "containerEnv": {
    "AZURE_BICEP_CHECK_VERSION": "false",
    "AZURE_CORE_COLLECT_TELEMETRY": "false",
    "AZURE_DEV_COLLECT_TELEMETRY": "no",
    "LIVEKS_VENV": ".liveks/venv-devcontainer",
    "NEXT_TELEMETRY_DISABLED": "1",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postAttachCommand": "bash .devcontainer/welcome.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-bicep",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.liveks/venv-devcontainer/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
