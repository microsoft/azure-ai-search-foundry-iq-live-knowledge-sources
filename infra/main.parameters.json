{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "baseName": {
      "value": "${AZURE_BASE_NAME}"
    },
    "nameSalt": {
      "value": "${AZURE_NAME_SALT}"
    },
    "staticWebAppLocation": {
      "value": "${AZURE_STATIC_WEB_APP_LOCATION}"
    },
    "hostingMode": {
      "value": "${AZURE_HOSTING_MODE}"
    },
    "appServiceSku": {
      "value": "${AZURE_APP_SERVICE_SKU}"
    },
    "searchSku": {
      "value": "${AZURE_SEARCH_SKU}"
    },
    "deploymentMode": {
      "value": "${DEPLOYMENT_MODE}"
    },
    "fabricCapacityMode": {
      "value": "${FABRIC_CAPACITY_MODE}"
    },
    "fabricLocation": {
      "value": "${FABRIC_LOCATION}"
    },
    "fabricCapacityName": {
      "value": "${FABRIC_CAPACITY_NAME}"
    },
    "fabricCapacitySku": {
      "value": "${FABRIC_CAPACITY_SKU}"
    },
    "fabricCapacityAdmin": {
      "value": "${FABRIC_CAPACITY_ADMIN}"
    },
    "chatDeploymentName": {
      "value": "${AZURE_OPENAI_DEPLOYMENT_ID}"
    },
    "chatModelName": {
      "value": "${AZURE_OPENAI_MODEL_NAME}"
    },
    "chatModelVersion": {
      "value": "${AZURE_OPENAI_MODEL_VERSION}"
    },
    "chatDeploymentCapacity": {
      "value": "${AZURE_OPENAI_DEPLOYMENT_CAPACITY}"
    },
    "searchApiVersion": {
      "value": "${AZURE_SEARCH_API_VERSION}"
    },
    "airlineOpsIndexName": {
      "value": "${AIRLINE_OPS_INDEX_NAME}"
    },
    "mcpKnowledgeSourceName": {
      "value": "${MCP_KNOWLEDGE_SOURCE_NAME}"
    },
    "fabricKnowledgeSourceName": {
      "value": "${FABRIC_ONTOLOGY_KNOWLEDGE_SOURCE_NAME}"
    },
    "mcpOnlyKnowledgeBaseName": {
      "value": "${MCP_ONLY_KNOWLEDGE_BASE_NAME}"
    },
    "knowledgeBaseName": {
      "value": "${KNOWLEDGE_BASE_NAME}"
    }
  }
}
